# Required: OpenAI-compatible AI Gateway (e.g. Vercel AI Gateway)
GATEWAY_URL=https://ai-gateway.vercel.sh/v1
GATEWAY_KEY=

# Optional: override evaluation & copy models
JEV_MODEL=typesafe-ai/jev-1.14.0
ROAST_MODEL=anthropic/claude-haiku-5.5

# Optional: server & guardrails
PORT=3042
DAILY_LLM_USD_CAP=5
PUBLIC_BASE_URL=http://127.0.0.1:3042
ROAST_CACHE_DIR=./.cache

# Optional: Redis/KV persistence (falls back to local disk cache when unset)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: PostHog analytics
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
